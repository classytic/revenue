{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "verbatimModuleSyntax": true, "declaration": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tsdown.config.ts", "vitest.config.ts"]
}
